#!/bin/bash
# OS_NAME_PLACEHOLDER system test
echo "== OS_NAME_PLACEHOLDER System Test =="
echo "CPU:    $(nproc) cores"
echo "RAM:    $(free -h | awk '/Mem:/{print $2}')"
echo "Disk:   $(lsblk -dno NAME,SIZE | head -n1)"
if ping -c1 -W2 1.1.1.1 >/dev/null 2>&1; then echo "Net:    OK"; else echo "Net:    no connection"; fi
echo "All tests passed."

# Easter egg: run with --woof, or it triggers on the 13th run
COUNT=/var/tmp/.pugos-count
n=$(( $(cat "$COUNT" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$COUNT" 2>/dev/null
if [ "$1" = "--woof" ] || [ "$n" -eq 13 ]; then
  IMG=/usr/lib/pugos/systest/.cache/.p
  cp "$IMG" /tmp/pug.jpg 2>/dev/null
  xdg-open /tmp/pug.jpg 2>/dev/null || echo "Woof! Pug saved to /tmp/pug.jpg"
fi
